doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  title Photo Gallery Setup
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet')
  style.
    body {
    background: #fbeeff;
    font-family: "Quicksand", sans-serif;
    }
    .form-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    padding: 30px;
    max-width: 500px;
    margin: 40px auto;
    }
    .step-indicators {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    }
    .step-circle {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background-color: #dee2e6;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 5px;
    }
    .step-circle.active {
    background-color: #ff5c8d;
    }
    .tab-btn.active {
    background-color: #ffe6ef !important;
    color: #ff3f75 !important;
    font-weight: 600;
    }
    .hidden {
    display: none;
    }
    .tab-content {
    max-height: 180px;
    /* Giới hạn chiều cao hiển thị */
    overflow-y: auto;
    /* Bật scroll dọc nếu vượt quá */
    padding-right: 5px;
    /* Giữ khoảng cách với thanh cuộn */
    }
    /* ----- Tùy chỉnh thanh scroll (cho Chrome, Edge, Safari) ----- */
    .tab-content::-webkit-scrollbar {
    width: 8px;
    /* Độ rộng thanh cuộn */
    }
    .tab-content::-webkit-scrollbar-track {
    background: #ffeef4;
    /* Màu nền rãnh */
    border-radius: 10px;
    }
    .tab-content::-webkit-scrollbar-thumb {
    background: #ff5c8d;
    /* Màu thanh cuộn */
    border-radius: 10px;
    }
    .tab-content::-webkit-scrollbar-thumb:hover {
    background: #ff3f75;
    /* Khi hover */
    }
    /* ----- Tùy chỉnh thanh cuộn cho Firefox ----- */
    .tab-content {
    scrollbar-width: thin;
    scrollbar-color: #ff5c8d #ffeef4;
    }
    /* ----- Textarea styling (Lời nhắn gửi) ----- */
    .message-box,
    .message-box-dear {
    background-color: #fff8fb;
    /* Nền hồng nhạt */
    border: 2px solid #ffd1e0;
    /* Viền pastel */
    border-radius: 15px;
    /* Bo góc mềm mại */
    padding: 12px 15px;
    font-size: 1rem;
    resize: vertical;
    /* Cho phép kéo giãn theo chiều dọc */
    transition: all 0.3s ease;
    }
    .message-box-dear {
    height: 50px;
    }
    .message-box::placeholder,
    .message-box-dear::placeholder {
    color: #ff9ab6;
    /* Màu placeholder dịu */
    font-style: italic;
    }
    .message-box:focus {
    outline: none;
    border-color: #ff5c8d;
    /* Viền hồng đậm khi focus */
    background-color: #fff0f6;
    /* Nền sáng hơn khi gõ */
    box-shadow: 0 0 8px rgba(255, 92, 141, 0.3);
    }
    .video-upload {
    background-color: #fff8fb;
    border: 2px dashed #ffd1e0;
    border-radius: 15px;
    padding: 10px;
    transition: all 0.3s ease;
    cursor: pointer;
    }
    .video-upload:hover {
    border-color: #ff5c8d;
    background-color: #fff0f6;
    }
    .video-upload:focus {
    outline: none;
    border-color: #ff5c8d;
    box-shadow: 0 0 8px rgba(255, 92, 141, 0.3);
    }
    /* Tùy chọn: hiển thị video preview nhỏ */
    #videoPreview {
    width: 100%;
    margin-top: 10px;
    border-radius: 10px;
    display: none;
    }
    .audio-upload {
    background-color: #fff8fb;
    border: 2px dashed #ffd1e0;
    border-radius: 15px;
    padding: 10px;
    transition: all 0.3s ease;
    cursor: pointer;
    }
    .audio-upload:hover {
    border-color: #ff5c8d;
    background-color: #fff0f6;
    }
    .audio-upload:focus {
    outline: none;
    border-color: #ff5c8d;
    box-shadow: 0 0 8px rgba(255, 92, 141, 0.3);
    }
    /* Preview audio style */
    #audioPreview {
    border-radius: 10px;
    background: #fff8fb;
    box-shadow: 0 0 6px rgba(255, 92, 141, 0.2);
    }
    #suggested.tab-content {
        max-height: 300px;
        overflow-y: auto;
        padding-right: 5px;
    }

        /* Tùy chỉnh thanh cuộn */
    #suggested.tab-content::-webkit-scrollbar {
        width: 6px;
    }
    #suggested.tab-content::-webkit-scrollbar-thumb {
        background: #d1b3ff;
        border-radius: 10px;
    }
    #suggested.tab-content::-webkit-scrollbar-thumb:hover {
        background: #b37aff;
    }

        /* Thẻ bài hát */
    #suggested .list-group-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f9f3ff;
        border: 1px solid #e6ccff;
        border-radius: 12px;
        margin-bottom: 8px;
        padding: 8px 12px;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        /* Hiệu ứng hover */
    #suggested .list-group-item:hover {
        background: #f0e0ff;
        box-shadow: 0 2px 6px rgba(180, 130, 255, 0.2);
    }

        /* Radio + tên bài hát */
    #suggested .list-group-item input[type="radio"] {
        accent-color: #a46cff;
        margin-right: 8px;
        transform: scale(1.2);
    }

    #suggested .list-group-item span, #suggested .list-group-item label {
        flex: 1;
        font-weight: 500;
        color: #5b2cc7;
    }

        /* Player nhỏ gọn */
    #suggested audio {
        width: 130px;
        height: 28px;
        border-radius: 6px;
        background-color: #fff;
        outline: none;
    }

        /* Tùy chỉnh khung audio (ẩn background mặc định trên Chrome) */
    #suggested audio::-webkit-media-controls-panel {
        background-color: transparent;
    }
    #suggested audio::-webkit-media-controls-play-button {
        filter: hue-rotate(270deg) brightness(1.3);
    }
.form-card
  h3.text-center.text-danger.fw-bold.mb-4 T&#x1EA1;o m&#x1EAB;u 
  // Steps
  .step-indicators
    .step-circle.active 1
    .step-circle 2
    .step-circle 3
    .step-circle 4
  form#galleryForm
    // Step 1
    .step.active
      h5.mb-3 &#x1F3B5; Chọn một bài hát
      // Tabs
      ul#songTabs.nav.nav-pills.mb-3.justify-content-center
        li.nav-item
          button.nav-link.tab-btn.active(type='button' data-tab='suggested') Nh&#x1EA1;c &dstrok;&#x1EC1; xu&#x1EA5;t
        li.nav-item
          button.nav-link.tab-btn(type='button' data-tab='custom') Li&ecirc;n k&#x1EBF;t t&ugrave;y ch&#x1EC9;nh
      #suggested.tab-content
        .list-group
          label.list-group-item
            input.form-check-input.me-2(type='radio' name='song' value='The Perfect Fan - Backstreet Boys')
            |                             &#x1F3A7; Hơn Cả Yêu - Đức Phúc
            audio(controls preload='none' style='width:130px; height:30px;')
                source(src='https://giftlove-bucket.s3.ap-southeast-2.amazonaws.com/Sound/7109713857460.mp3' type='audio/mpeg')
                | Trình duyệt của bạn không hỗ trợ audio.
      #custom.tab-content.hidden
        input.form-control.mt-2(type='text' placeholder='Dán liên kết YouTube của bạn vào đây')
      button.btn.btn-danger.mt-4.next-btn.w-100(type='button') Ti&#x1EBF;p theo &#x279C;
    // Step 2
    .step.hidden
      each field in fields
        if field.step == "2"
          if field.type === "textarea"
            h5.mb-3 &#x1F48C; #{field.label}
            textarea.form-control.message-box.mb-3(rows='6' placeholder='Xin chào')
          else if field.type === "text"
           h5.mb-3 &#x1F48C; #{field.label}
           input.form-control.message-box-dear.mb-3(placeholder="Hi" type='text')

          
      .d-flex.justify-content-between.mt-3
        button.btn.btn-secondary.prev-btn(type='button') &#x2B05; Quay l&#x1EA1;i
        button.btn.btn-danger.next-btn(type='button') Ti&#x1EBF;p theo &#x279C;
    // Step 3
    .step.hidden
      each field in fields
        if field.step == "3"
          if field.type === "video"
            h5.mb-3 &#x1F4F8; #{field.label}
            input#videoUpload.form-control.video-upload.mb-3(type='file' accept='video/*')
          else if field.type === "voice"
            h5.mb-3 &#x1F4F8; #{field.label}
            input#audioUpload.form-control.audio-upload(type='file' accept='audio/*')
            audio#audioPreview(controls='' style='width:100%; margin-top:10px; display:none;')
  
      .d-flex.justify-content-between.mt-3
        button.btn.btn-secondary.prev-btn(type='button') &#x2B05; QUay l&#x1EA1;i
        button.btn.btn-danger.next-btn(type='button') Ti&#x1EBF;p theo &#x279C;
    // Step 4
    .step.hidden
      h5.mb-3 &#x2705; Ho&agrave;n t&#x1EA5;t
      p
        | &Dstrok;&atilde; ho&agrave;n t&#x1EA5;t qu&aacute; tr&igrave;nh chu&#x1EA9;n b&#x1ECB; n&#x1ED9;i dung, D&#x1EEF; li&#x1EC7;u s&#x1EBD; &dstrok;&#x1B0;&#x1EE3;c chuy&#x1EC3;n &dstrok;&#x1EBF;n c&#x1EED;a h&agrave;ng &dstrok;&#x1EC3; t&#x1EA1;o m&atilde; v&agrave; k&egrave;m theo
        | qu&agrave;, H&atilde;y nh&#x1EA5;n &quot; T&#x1EA1;o m&#x1EAB;u &quot; &dstrok;&#x1EC3; t&#x1EA1;o m&#x1EAB;u nh&eacute;.
      .d-flex.justify-content-between
        button.btn.btn-secondary.prev-btn(type='button') &#x2B05; Quay l&#x1EA1;i
        button.btn.btn-success(type='submit') T&#x1EA1;o m&#x1EAB;u
script.
  document.addEventListener("DOMContentLoaded", () => {
  const steps = document.querySelectorAll('.step');
  const indicators = document.querySelectorAll('.step-circle');
  const nextBtns = document.querySelectorAll('.next-btn');
  const prevBtns = document.querySelectorAll('.prev-btn');
  let currentStep = 0;
  function showStep(index) {
  steps.forEach((s, i) => {
  s.classList.toggle('hidden', i !== index);
  s.classList.toggle('active', i === index);
  indicators[i].classList.toggle('active', i === index);
  });
  }
  nextBtns.forEach(btn => {
  btn.addEventListener('click', () => {
  if (currentStep < steps.length - 1) {
  currentStep++;
  showStep(currentStep);
  }
  });
  });
  prevBtns.forEach(btn => {
  btn.addEventListener('click', () => {
  if (currentStep > 0) {
  currentStep--;
  showStep(currentStep);
  }
  });
  });
  // Tabs
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');
  tabBtns.forEach(btn => {
  btn.addEventListener('click', () => {
  tabBtns.forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  tabContents.forEach(c => c.classList.add('hidden'));
  document.getElementById(btn.dataset.tab).classList.remove('hidden');
  });
  });
  // Preview âm thanh
  const audioInput = document.getElementById('audioUpload');
  const audioPreview = document.getElementById('audioPreview');
  audioInput.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (file) {
  audioPreview.src = URL.createObjectURL(file);
  audioPreview.style.display = 'block';
  audioPreview.play();
  } else {
  audioPreview.style.display = 'none';
  audioPreview.src = '';
  }
  });
  // Hiển thị bước đầu tiên khi load trang
  showStep(currentStep);
  });
